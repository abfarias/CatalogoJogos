@page
@model CatalogoJogos.Pages.Conta.RegistrarModel
@{
    ViewData["Title"] = "Criar conta";
}

<h1>@ViewData["Title"]</h1>

<form method="post" class="col-md-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Dados.Apelido" class="form-label"></label>
        <input asp-for="Dados.Apelido" class="form-control" />
        <span asp-validation-for="Dados.Apelido" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Dados.Email" class="form-label"></label>
        <input asp-for="Dados.Email" class="form-control" autocomplete="username" />
        <span asp-validation-for="Dados.Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Dados.Senha" class="form-label"></label>
        <input asp-for="Dados.Senha" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Dados.Senha" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Dados.ConfirmarSenha" class="form-label"></label>
        <input asp-for="Dados.ConfirmarSenha" class="form-control" autocomplete="new-password" />
        <span asp-validation-for="Dados.ConfirmarSenha" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Criar conta</button>
</form>

<p class="mt-3">Já tem conta? <a asp-page="/Conta/Login">Entrar</a></p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
