@page
@model CatalogoJogos.Pages.Catalogo.ExplorarModel
@{
    ViewData["Title"] = "Explorar Jogos";
    var culture = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
}

<h1>@ViewData["Title"]</h1>

<partial name="_Mensagens" />

@if (Model.JogosDisponiveis.Count == 0)
{
    <p>Nenhum jogo encontrado.</p>
}
else
{
    <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var jogo in Model.JogosDisponiveis)
        {
            <div class="col">
                <div class="card h-100">
                    <partial name="_CapaJogo" model="jogo" />
                    <div class="card-body">
                        <h2 class="card-title h5">@jogo.Titulo</h2>
                        <p class="card-text text-muted mb-1">@jogo.Categoria</p>
                        <p class="card-text">@jogo.Descricao</p>
                    </div>
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <span class="fw-bold">@jogo.Preco.ToString("C", culture)</span>
                        @if (Model.IdsNaBiblioteca.Contains(jogo.IdJogo))
                        {
                            <span class="badge bg-success">Na biblioteca</span>
                        }
                        else if (User.EhJogador())
                        {
                            <form method="post" asp-page-handler="Comprar" asp-route-idJogo="@jogo.IdJogo">
                                <button type="submit" class="btn btn-sm btn-primary">Comprar</button>
                            </form>
                        }
                        else if (User.Identity?.IsAuthenticated != true)
                        {
                            <a asp-page="/Conta/Login" class="btn btn-sm btn-outline-primary">Entrar para comprar</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
