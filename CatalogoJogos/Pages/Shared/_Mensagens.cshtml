@* Mensagens de sucesso e de erro guardadas em TempData pelas páginas antes de redirecionar. *@
@if (TempData["Mensagem"] is string mensagem)
{
    <div class="alert alert-success">@mensagem</div>
}
@if (TempData["Erro"] is string erro)
{
    <div class="alert alert-danger">
        @erro
        @if (erro == CompraService.MensagemSaldoInsuficiente)
        {
            <a asp-page="/Jogador/Carteira" class="alert-link">Adicionar saldo</a>
        }
    </div>
}
