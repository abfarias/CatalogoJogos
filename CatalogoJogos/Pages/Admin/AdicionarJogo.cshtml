@page
@model CatalogoJogos.Pages.Admin.AdicionarJogoModel
@{
    ViewData["Title"] = "Adicionar Jogo";
}

<h1>@ViewData["Title"]</h1>

<form method="post">
    <partial name="_FormJogo" for="Jogo" />

    <button type="submit" class="btn btn-primary">Salvar Jogo</button>
    <a asp-page="/Admin/Jogos" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
